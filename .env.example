# ==============================================================================
# StayNest PG Management SaaS - Environment Variables Configuration
# ==============================================================================

# Supabase Project URL & Anonymous Key (Public - exposed to browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# (Optional Publishable Key alias used in newer Supabase SSR setups)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key-here"

# Supabase Service Role Key (SERVER ONLY - NEVER expose to browser)
# Required for Super Admin operations, user management, and privileged tasks
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
SUPABASE_URL="https://your-project-id.supabase.co"

# Super Admin Allowed Emails (Comma-separated list of verified admin accounts)
SUPER_ADMIN_EMAILS="abhishekrawat67320@gmail.com,sharmavn258@gmail.com,admin@staynest.in"

# Dev/Production Auth Redirect URL
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL="http://localhost:3000/auth/callback"
