# ==============================================================================
# StayNest SaaS — Enterprise Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# For production, configure these variables in Vercel Project Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DEPLOYMENT
# ------------------------------------------------------------------------------
NODE_ENV="development" # "development" | "production" | "test"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="getstaynest@gmail.com"

# ------------------------------------------------------------------------------
# 2. SUPABASE INFRASTRUCTURE (Multi-Tenant Database & Auth)
# ------------------------------------------------------------------------------
# Public Supabase API credentials (safe to expose to client bundle)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key-here"

# Private Supabase Service Role Key (SERVER ONLY — NEVER EXPOSE TO CLIENT)
# Required for Super Admin bootstrapping, platform audit logs, and account erasure
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Super Admin Authorized Emails (Comma-separated list of founder co-owner accounts)
SUPER_ADMIN_EMAILS="founder1@example.com,founder2@example.com"
# One-time bootstrap password (strictly read by CLI bootstrap script, never stored or committed)
SUPER_ADMIN_BOOTSTRAP_PASSWORD="YourTemporaryBootstrapPassword123!"

# Auth Redirect URL for email confirmation and magic links
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL="http://localhost:3000/auth/callback"

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY (India Domestic Payments: UPI, NetBanking, Cards)
# ------------------------------------------------------------------------------
# Obtain from: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID="rzp_test_yourKeyId"
RAZORPAY_KEY_SECRET="yourRazorpayKeySecret"
RAZORPAY_WEBHOOK_SECRET="yourRazorpayWebhookSecret"

# ------------------------------------------------------------------------------
# 4. STRIPE PAYMENT GATEWAY (Global Multi-Currency Billing)
# ------------------------------------------------------------------------------
# Obtain from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_yourStripePublishableKey"
STRIPE_SECRET_KEY="sk_test_yourStripeSecretKey"
STRIPE_WEBHOOK_SECRET="whsec_yourStripeWebhookSecret"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Resend / SendGrid / Custom SMTP)
# ------------------------------------------------------------------------------
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY="re_yourResendApiKeyHere"
EMAIL_FROM="StayNest Support <getstaynest@gmail.com>"

# ------------------------------------------------------------------------------
# 6. SENTRY OBSERVABILITY & ERROR TRACKING
# ------------------------------------------------------------------------------
# Obtain from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN="https://yourPublicKey@o0.ingest.sentry.io/0"
SENTRY_DSN="https://yourPublicKey@o0.ingest.sentry.io/0"
SENTRY_AUTH_TOKEN="yourSentryAuthToken"

# ------------------------------------------------------------------------------
# 7. RATE LIMITING & ABUSE PROTECTION (Optional Distributed Upstash Redis)
# ------------------------------------------------------------------------------
# When not set, the middleware uses high-performance in-memory sliding window
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
